/*
 * Optimized 38-Key Programmer Layout for Totem
 * Based on Colemak-DH and Timeless Home Row Mods
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/* Layer Definitions */
#define BASE 0
#define SYM  1
#define NUM  2
#define SYS  3

/ {
    behaviors {
        /*
         * Timeless Home Row Mods
         * Flavor: tap-preferred (prioritizes typing over holding)
         * Hold-trigger-on-release: Mod only activates if you press another key while holding
         */
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
            hold-trigger-on-release; 
            bindings = <&kp>, <&kp>;
        };

        /*
         * Isolated Shift (Thumb)
         * Flavor: hold-preferred (ensures Shift activates reliably)
         */
        tm: thumb_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_MOD";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "hold-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";
        /* Caps Word: Press Left Shift + Right Shift (Thumbs) together */
        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <36 39>; /* Adjust based on exact thumb indices if needed, these are inner thumbs */
            bindings = <&caps_word>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * Layer 0: BASE (Colemak-DH)
         * HRMs: Left (Alt, GUI, Ctrl, Alpha) | Right (Alpha, Ctrl, GUI, Alt)
         * Thumbs: Sym/Space/Tab | Backspace/Enter-Shift/Num
         */
        default_layer {
            bindings = <
            /* Pinky Col       Ring      Middle    Index     Index (Inner)    |   Index (Inner) Index     Middle    Ring      Pinky Col */
              &kp Q           &kp W     &kp F     &kp P     &kp B                &kp J         &kp L     &kp U     &kp Y     &kp APOS
              &hm LALT A      &hm LGUI R &hm LCTRL S &kp T   &kp G                &kp M         &kp N     &hm RCTRL E &hm RGUI I &hm RALT O
      &kp Z   &kp X           &kp C     &kp D     &kp V     &kp Z                &kp K         &kp H     &kp COMMA &kp DOT   &kp FSLH  &kp SEMI
                                        &lt SYM TAB &kp SPACE &kp ESC            &kp DEL       &tm RSHIFT RET  &lt NUM BSPC
            >;
        };

        /*
         * Layer 1: SYMBOLS (Programming Focused)
         * Activated by Left Thumb
         * Strategy: Paired delimiters on Home Row, Math on Left, Brackets on Right
         */
        sym_layer {
            bindings = <
              &kp EXCL        &kp AT    &kp HASH  &kp DLLR  &kp PRCNT            &kp CARET     &kp AMPS  &kp STAR  &kp MINUS &kp GRAVE
              &kp BSLH        &kp PIPE  &kp LBRC  &kp LPAR  &kp LBKT             &kp RBKT      &kp RPAR  &kp RBRC  &kp EQUAL &kp PLUS
      &trans  &trans          &trans    &trans    &trans    &trans               &trans        &trans    &trans    &trans    &trans    &trans
                                        &trans    &trans    &trans               &trans        &trans    &trans
            >;
        };

        /*
         * Layer 2: NUMBER & NAV (VIM + Numpad)
         * Activated by Right Thumb
         * Left Hand: Numpad (Top 789, Home 456, Bot 123)
         * Right Hand: Navigation (Home Row HJKL)
         */
        num_layer {
            bindings = <
              &trans          &kp N7    &kp N8    &kp N9    &trans               &kp PG_UP     &kp HOME  &kp UP    &kp END   &trans
              &trans          &kp N4    &kp N5    &kp N6    &kp N0               &kp PG_DN     &kp LEFT  &kp DOWN  &kp RIGHT &trans
      &trans  &trans          &kp N1    &kp N2    &kp N3    &trans               &trans        &trans    &trans    &trans    &trans    &trans
                                        &trans    &trans    &trans               &trans        &trans    &trans
            >;
        };

        /*
         * Layer 3: SYSTEM (F-Keys, Media, BT)
         * Activated by holding both Layer Thumbs (Tri-layer) or add a specific toggle if preferred
         * Currently accessible if you map a key to &mo SYS. 
         * For now, I will map it to the "Side Pinky" on Base layer if you prefer, 
         * or you can access it via Combo.
         */
        sys_layer {
            bindings = <
              &kp F12         &kp F7    &kp F8    &kp F9    &kp F10              &bt BT_SEL 0  &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR
              &kp F11         &kp F4    &kp F5    &kp F6    &trans               &out OUT_BLE  &trans    &trans    &trans    &trans
      &trans  &trans          &kp F1    &kp F2    &kp F3    &trans               &out OUT_USB  &trans    &trans    &trans    &trans    &trans
                                        &trans    &trans    &trans               &trans        &trans    &trans
            >;
        };
    };
};
